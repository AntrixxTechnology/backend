# Backend Server Config
PORT=5000
NODE_ENV=development

# CORS Config
CORS_ORIGIN_FRONTEND=http://localhost:5173
CORS_ORIGIN_ADMIN=http://localhost:5174

# Admin JWT Secret & Auth Config
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Optional Supabase Database Credentials (If omitted, backend defaults to LocalJsonRepository)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email Notifications via Resend (Recommended for Vercel / Serverless)
RESEND_API_KEY=
RESEND_ENQUIRY_FROM=enquiries@example.com
RESEND_NOREPLY_FROM=donotreply@example.com
RESEND_CAREERS_FROM=careers@example.com
ADMIN_NOTIFICATION_EMAIL=help@example.com

# Optional Email SMTP Config (Fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
